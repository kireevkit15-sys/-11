# Public apex domain for the marketing site (Next.js -> web container).
DOMAIN=example.com

# Admin / CMS hostname (Strapi -> cms container).
ADMIN_DOMAIN=admin.example.com

# Email used for Let's Encrypt ACME registration / expiry notices.
ACME_EMAIL=admin@example.com

# Optional: bcrypt hash for an HTTP basic-auth gate in front of Strapi admin.
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mypassword'
# Note: when storing in a docker-compose .env file, escape every literal $ as $$
# so compose does not interpolate it.
ADMIN_BCRYPT_HASH=$2a$14$REPLACE_WITH_REAL_HASH
