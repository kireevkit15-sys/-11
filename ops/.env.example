# Diva — environment variables (copy to .env and fill in).
# Never commit .env to git. .env.example holds only safe placeholders.

# -----------------------------------------------------------------------------
# PostgreSQL (postgres service)
# -----------------------------------------------------------------------------
POSTGRES_USER=diva
POSTGRES_PASSWORD=changeme
POSTGRES_DB=diva

# -----------------------------------------------------------------------------
# Strapi CMS (cms service)
# Generate each secret with: `openssl rand -base64 32`
# -----------------------------------------------------------------------------
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# -----------------------------------------------------------------------------
# Next.js web (web service)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
DATABASE_URL=postgres://diva:changeme@postgres:5432/diva

# -----------------------------------------------------------------------------
# Telegram bot (bot service)
# -----------------------------------------------------------------------------
BOT_TOKEN=
# Telegram chat id of the РОП (sales lead) to receive new lead notifications.
ROP_CHAT_ID=
WEB_BASE_URL=

# -----------------------------------------------------------------------------
# Caddy reverse proxy (prod only)
# -----------------------------------------------------------------------------
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=
