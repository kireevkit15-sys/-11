# Diva — environment variables (copy to .env and fill in).
# Never commit .env to git. .env.example holds only safe placeholders.

# -----------------------------------------------------------------------------
# PostgreSQL (postgres service)
# -----------------------------------------------------------------------------
POSTGRES_USER=diva
POSTGRES_PASSWORD=changeme
POSTGRES_DB=diva

# -----------------------------------------------------------------------------
# Next.js web (web service)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgres://diva:changeme@postgres:5432/diva

# -----------------------------------------------------------------------------
# Кастомная админ-панель (diva-admin service)
# Секрет сессии — минимум 32 символа: `openssl rand -hex 32`
# Доступна по адресу ${ADMIN_DOMAIN} (Caddy).
# -----------------------------------------------------------------------------
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Разовый сервис seed-admin (profiles: tools) — создаёт/сбрасывает
# администратора. Запуск: docker compose --profile tools run --rm seed-admin
# Оставить ADMIN_INITIAL_PASSWORD пустым — скрипт сгенерирует случайный
# пароль и выведет его в лог один раз.
# -----------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@diva.ru
ADMIN_INITIAL_PASSWORD=

# -----------------------------------------------------------------------------
# Telegram bot (bot service)
# -----------------------------------------------------------------------------
BOT_TOKEN=
# Telegram chat id of the РОП (sales lead) to receive new lead notifications.
ROP_CHAT_ID=

# -----------------------------------------------------------------------------
# Caddy reverse proxy (prod only)
# -----------------------------------------------------------------------------
# ADMIN_DOMAIN — поддомен кастомной админ-панели (diva-admin).
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=

# -----------------------------------------------------------------------------
# Web <-> Admin: on-demand revalidation webhook
# Admin дёргает web после каждой мутации (POST/PUT/DELETE), чтобы web
# немедленно сбросил ISR-кеш. Секрет — минимум 32 символа: `openssl rand -hex 32`.
# В compose маппится: web → REVALIDATE_SECRET, admin → WEB_REVALIDATE_SECRET.
# Если секрет не задан — webhook падает в 401, и сайт показывает старые
# данные после правок в админке.
# -----------------------------------------------------------------------------
REVALIDATE_SECRET=
