{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Статья блога",
    "description": ""
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text", "maxLength": 280 },
    "body": { "type": "richtext" },
    "cover": { "type": "media", "multiple": false, "required": false, "allowedTypes": ["images"] },
    "category": { "type": "enumeration", "enum": ["ФСИ", "Налоги", "ООО", "Гранты", "Прочее"] },
    "reading_minutes": { "type": "integer", "default": 5 },
    "seo_title": { "type": "string" },
    "seo_description": { "type": "text" }
  }
}
