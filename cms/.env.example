# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate with: openssl rand -base64 32
APP_KEYS=changeMe1,changeMe2
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# Database
# Dev:  DATABASE_CLIENT=sqlite  (uses .tmp/data.db)
# Prod: DATABASE_CLIENT=postgres + DATABASE_URL=postgres://user:pass@host:5432/diva_cms
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production Postgres (uncomment and set at deploy time)
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/diva_cms
# DATABASE_SSL=true
